# Test Environment Variables
NODE_ENV=test

# Database
# Use a separate test database to avoid conflicts
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_test"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_test"
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/hr_test"

# Disable external services in tests
NEXT_PUBLIC_TAVILY_AVAILABLE=false
NEXT_PUBLIC_OPENAI_AVAILABLE=false
NEXT_PUBLIC_SANDBOX_AVAILABLE=false

# Mock API keys (not used in tests)
OPENAI_API_KEY="sk-test-key"
ANTHROPIC_API_KEY="sk-ant-test-key"

# Required env vars for T3 env validation
AI_GATEWAY_API_KEY="test-gateway-key"
CRON_SECRET="test-cron-secret"
AUTH_SECRET="test-auth-secret"
BLOB_READ_WRITE_TOKEN="test-blob-token"

# Better Auth (use test secret)
BETTER_AUTH_SECRET="test-secret-key-for-testing-only-not-for-production"
BETTER_AUTH_URL="http://localhost:3000"
