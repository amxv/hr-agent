# Test Environment Variables
NODE_ENV=test

# Database
# Use a separate test database to avoid conflicts
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hr_test"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hr_test"

# Disable external services in tests
NEXT_PUBLIC_TAVILY_AVAILABLE=false
NEXT_PUBLIC_OPENAI_AVAILABLE=false
NEXT_PUBLIC_SANDBOX_AVAILABLE=false

# Mock API keys (not used in tests)
OPENAI_API_KEY="sk-test-key"
ANTHROPIC_API_KEY="sk-ant-test-key"

# Better Auth (use test secret)
BETTER_AUTH_SECRET="test-secret-key-for-testing-only-not-for-production"
BETTER_AUTH_URL="http://localhost:3000"
